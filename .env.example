NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
API_VERSION=1
DATABASE_URL=postgresql://localhost:5432/mercury_dev
DB_POOL_SIZE=10
BCRYPT_ROUNDS=12
JWT_SECRET=dev-secret-do-not-use-in-production
JWT_ISSUER=mercury
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Optional: bootstrap an initial admin user on first startup.
# Leave empty to skip. Never commit real credentials.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SMS_PROVIDER=development
UPLOAD_DIR=./uploads
# Production TODO: configure social provider IDs/secrets only when enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
